        "reports/experience_v4/executed_cycle/development_audit.json"
      ],
      "jobs": [
        {
          "job_id": "audit-development-trajectories",
          "argv": [
            "/data_b/qzluo/miniconda3/envs/verl-agent/bin/python",
            "scripts/audit_multitask_report.py",
            "--report-dir",
            "reports/experience_v4/qwen3_1.7b_valid_train_all_200",
            "--variants",
            "I",
            "--variant-experience",
            "I=reports/experience_v2/exp_v3.json",
            "--data-root",
            "/home/qzluo/.cache/alfworld",
            "--protocol-role",
            "development",
            "--output",
            "reports/experience_v4/executed_cycle/development_audit.json"
          ],
          "env": {
            "PYTHONPATH": "src"
          }
        }
      ]
    },
    {
      "stage_id": "experience_evolution",
      "depends_on": [
        "development_audit"
      ],
      "outputs": [
        "reports/experience_v4/executed_cycle/exp_v4.json"
