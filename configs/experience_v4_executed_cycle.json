            "--report-dir",
            "reports/experience_v4/qwen3_1.7b_valid_seen_all_140",
            "--variants",
            "I",
            "K",
            "--variant-experience",
            "I=reports/experience_v2/exp_v3.json",
            "--variant-experience",
            "K=reports/experience_v4/executed_cycle/exp_v4.json",
            "--data-root",
            "/home/qzluo/.cache/alfworld",
            "--protocol-role",
            "evaluation",
            "--exclude-episodes-root",
            "reports/experience_v4/qwen3_1.7b_valid_train_all_200/I",
            "--output",
