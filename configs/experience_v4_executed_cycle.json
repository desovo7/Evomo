            "--development-trajectories",
            "reports/experience_v4/qwen3_1.7b_valid_train_all_200/I",
            "--development-summary",
            "reports/experience_v4/qwen3_1.7b_valid_train_all_200/I/summary.json",
            "--development-audit",
            "reports/experience_v4/executed_cycle/development_audit.json",
            "--candidate-experience",
            "reports/experience_v4/executed_cycle/exp_v4.json",
            "--evolution-audit",
            "reports/experience_v4/executed_cycle/evolution_audit.json",
            "--validation-trajectories",
            "reports/experience_v4/qwen3_1.7b_valid_seen_all_140",
            "--validation-incumbent-summary",
            "reports/experience_v4/qwen3_1.7b_valid_seen_all_140/I/summary.json",
            "--validation-candidate-summary",
            "reports/experience_v4/qwen3_1.7b_valid_seen_all_140/K/summary.json",
            "--comparison",
            "reports/experience_v4/executed_cycle/validation/comparison.json",
            "--validation-audit",
            "reports/experience_v4/executed_cycle/validation/audit.json",
            "--decision",
            "reports/experience_v4/executed_cycle/decision.json",
            "--output",
            "reports/experience_v4/executed_cycle/cycle_manifest.json"
