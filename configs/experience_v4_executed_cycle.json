            "reports/experience_v4/executed_cycle/validation/audit.json",
            "--evolution-audit",
            "reports/experience_v4/executed_cycle/evolution_audit.json",
            "--incumbent",
            "reports/experience_v2/exp_v3.json",
            "--candidate",
            "reports/experience_v4/executed_cycle/exp_v4.json",
            "--output",
            "reports/experience_v4/executed_cycle/decision.json"
