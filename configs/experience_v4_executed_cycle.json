            "--all-tasks",
            "--variants",
            "I",
            "K",
            "--summary",
            "I=reports/experience_v4/qwen3_1.7b_valid_seen_all_140/I/summary.json",
            "--summary",
            "K=reports/experience_v4/qwen3_1.7b_valid_seen_all_140/K/summary.json"
          ],
          "env": {
            "PYTHONPATH": "src"
          }
        },
        {
          "job_id": "audit-paired-validation",
          "argv": [
            "/data_b/qzluo/miniconda3/envs/verl-agent/bin/python",
